# Environment Configuration Example
# Copy this file to .env and fill in your actual values

# ============================================================================
# OPENAI CONFIGURATION
# ============================================================================
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# ============================================================================
# ANTHROPIC CONFIGURATION (Optional - for Case Study 2)
# ============================================================================
ANTHROPIC_API_KEY=your-anthropic-api-key

# ============================================================================
# PINECONE CONFIGURATION (Case Study 1)
# ============================================================================
PINCONE_API_KEY=your-pinecone-api-key
PINCONE_INDEX_NAME=ecommerce-orders
PINCONE_ENVIRONMENT=us-west1-gcp

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/support_agents
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================================================
# GOOGLE CLOUD CONFIGURATION (Case Study 3)
# ============================================================================
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1

# ============================================================================
# LANGCHAIN CONFIGURATION (Case Study 3)
# ============================================================================
LANGCHAIN_API_KEY=your-langchain-api-key
LANGCHAIN_ENDPOINT=https://api.langchain.com

# ============================================================================
# SECURITY & ENCRYPTION (Case Study 2 - Banking)
# ============================================================================
ENCRYPTION_KEY=your-encryption-key-here
SECRET_KEY=your-secret-key-for-jwt
PCI_DSS_ENABLED=true
GDPR_ENABLED=true

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
DEBUG=False
LOG_LEVEL=INFO
ENVIRONMENT=production

# ============================================================================
# SERVICE PORTS
# ============================================================================
CASE_STUDY_1_PORT=8000
CASE_STUDY_2_PORT=8001
CASE_STUDY_3_PORT=8002

# ============================================================================
# COMPLIANCE & MONITORING
# ============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
PROMETHEUS_ENABLED=true
HEALTH_CHECK_INTERVAL=60

# ============================================================================
# CASE STUDY SPECIFIC SETTINGS
# ============================================================================

# Case Study 1: E-Commerce
ECOMMERCE_KNOWLEDGE_BASE_INDEX=ecommerce-faq
ORDER_SERVICE_TIMEOUT=30

# Case Study 2: Banking
BANK_COMPLIANCE_MODE=strict
MFA_REQUIRED=true
AUDIT_LOG_ENABLED=true

# Case Study 3: Enterprise
ENTERPRISE_MAX_CONCURRENT_SESSIONS=1000
CONTEXT_WINDOW_SIZE=32000
AUTO_ESCALATE_TIMEOUT_MINUTES=30
